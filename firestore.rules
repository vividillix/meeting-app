rules_version = '2';

// 임시 규칙 (로그인 도입 전)
// - 방 ID(링크)를 아는 사람만 그 방을 읽고 쓸 수 있음 — "링크 = 접근 권한" 모델
// - 전체 방 목록 조회, rooms 외 컬렉션 접근은 차단
// - 방 제목·날짜·최대 인원은 만든 뒤 바꿀 수 없음, 방장도 바꿀 수 없음
// 주의: 날짜 90일 제한은 src/constants/app.js 의 MAX_DATE_RANGE_DAYS 와 맞춰야 함
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidNewRoom(d) {
      return d.keys().hasOnly(['title', 'dates', 'maxPeople', 'hostId', 'votes'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.dates is list && d.dates.size() >= 1 && d.dates.size() <= 90
        && d.maxPeople is int && d.maxPeople >= 1
        && d.votes is map && d.votes.size() == 1
        && d.hostId is string && d.hostId in d.votes;
    }

    match /rooms/{roomId} {
      // 방 하나씩 읽기만 허용, 목록으로 긁어가기는 차단
      allow get: if true;
      allow list: if false;

      allow create: if isValidNewRoom(request.resource.data);

      // 참가·투표·강퇴·나가기는 votes만 바뀜
      // hostId는 방장 없는 예전 방에서 첫 입장자가 정해질 때만 바뀔 수 있음
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'hostId'])
        && (request.resource.data.hostId == resource.data.hostId || resource.data.hostId == null)
        && request.resource.data.votes is map
        && request.resource.data.votes.size() <= resource.data.maxPeople;

      // 로그인이 없어서 방장만 삭제하도록 막을 수는 없음 (다음 단계에서 해결)
      allow delete: if true;
    }
  }
}
