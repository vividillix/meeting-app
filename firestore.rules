rules_version = '2';

// 최종 규칙 (익명 로그인 + 서버 함수 도입 후)
// - 방 생성·입장·강퇴·나가기는 서버(api/)가 Admin SDK로 처리 → 규칙과 무관하게 서버가 권한 확인
// - 브라우저가 직접 할 수 있는 일: 방 하나 읽기, "내 투표 날짜" 수정 — 이것만 허용
// - 비밀번호 해시(roomSecrets)는 규칙이 없으므로 브라우저에서 읽기·쓰기 모두 불가
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      // 방 ID(링크)를 아는 로그인 사용자만 그 방 하나를 읽음. 목록 조회는 차단
      allow get: if request.auth != null;
      allow list: if false;

      allow create, delete: if false;

      // 진행 중 회차(round)의 "내 투표 날짜"만 바꿀 수 있음. 날짜가 확정된 회차는 불가
      allow update: if isMember() && isRoundOpen() && onlyOwnDatesChanged();

      function isRoundOpen() {
        return ('round' in resource.data) && resource.data.round.get('status', 'open') != 'closed';
      }

      function isMember() {
        return request.auth != null
          && ('memberUids' in resource.data)
          && request.auth.uid in resource.data.memberUids;
      }

      // 이 기기(uid)가 방에서 쓰는 닉네임
      function myName() {
        return resource.data.memberUids[request.auth.uid];
      }

      function onlyOwnDatesChanged() {
        let before = resource.data.round;
        let after = request.resource.data.round;
        let me = myName();
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['round'])
          && after.diff(before).affectedKeys().hasOnly(['votes'])
          && me in before.votes
          && after.votes.diff(before.votes).affectedKeys().hasOnly([me])
          && after.votes[me].keys().hasOnly(['dates'])
          && after.votes[me].dates is list
          && after.votes[me].dates.size() <= before.dates.size()
          && after.votes[me].dates.hasOnly(before.dates);
      }
    }
  }
}
